# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Dashboard → Settings → API Keys → Publishable (또는 legacy anon JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Optional — invite links shown to host
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — NEVER reuse the publishable key here
# Dashboard → Settings → API Keys → Secret (sb_secret_...) 또는 legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
